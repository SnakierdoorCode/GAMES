popup/item_5/id = 5

[node name="Label" type="Label" parent="VBoxContainer/VBoxContainer"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 14
text = "The sampling buffer changes how the game waits between samples from audio that's playing. This only affects Dub Mode, the clip editor preview, and the mic check, because those are the only places that the new setup is being used. I have created multiple options in hopes that at least one will work for all users.

\"Physics Frame\" was the original method, but has an occasional timing issue. I tried fixing this with \"Float Timer\", but at least one user reported sampling happening too quickly with it."
autowrap_mode = 2

[node name="HSeparator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="VBoxContainer2" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer/VBoxContainer2"]
layout_mode = 2

[node name="Label" type="Label" parent="VBoxContainer/VBoxContainer2/HBoxContainer"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
text = "Countdown Type"
horizontal_alignment = 2

[node name="OptionCountdownType" type="OptionButton" parent="VBoxContainer/VBoxContainer2/HBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 32)
layout_mode = 2
clip_text = true
item_count = 2
popup/item_0/text = "Timing Lights"
popup/item_0/id = 0
popup/item_1/text = "2... 1... GO!"
popup/item_1/id = 1

[node name="Label" type="Label" parent="VBoxContainer/VBoxContainer2"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 14
text = "How the gameshow counts down to recording.
The default is the \"Timing Lights,\" which make a noise as they tick down, with the final light being silent because it lights up the moment recording actually starts.

It has replaced the \"2-1-GO!\" overlay. That overlay had to wait to disappear before recording began, resulting in a delay between it telling you \"GO!\" and actually recording. It has been included here as a debug option to return to for now."
autowrap_mode = 2
