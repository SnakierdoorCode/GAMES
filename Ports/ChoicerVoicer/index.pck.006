unique_name_in_owner = true
custom_minimum_size = Vector2(320, 32)
layout_mode = 2
clip_text = true
item_count = 6
popup/item_0/text = "Physics Frame"
popup/item_0/id = 0
popup/item_1/text = "Process Frame"
popup/item_1/id = 1
popup/item_2/text = "Float Timer"
popup/item_2/id = 2
popup/item_3/text = "Physics Frame w/ Millisecond Check"
popup/item_3/id = 3
popup/item_4/text = "Process Frame w/ Millisecond Check"
popup/item_4/id = 4
