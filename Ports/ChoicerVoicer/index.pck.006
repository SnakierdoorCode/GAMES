[node name="LblDescription" parent="MarginContainer/Original/MarginContainer/VBoxContainer/HBoxContainer/GameModeInfo/InfoTwitchStandard/VBoxContainer" index="2"]
text = "Step on up to The Choicer Voicer game show studio!
Each round, a voice clip will play for you. Impersonate the
audio as well as you can.

Your impressions will be judged by Twitch chat, who
votes via chat commands.

End with a percentage of 60% or better to win!"

